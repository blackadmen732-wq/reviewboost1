# ReviewBoost API configuration
#
# Every value here is validated at boot by src/config/index.js. The process
# refuses to start on an invalid or incomplete value rather than failing later,
# in production, as silence.
#
# Copy to .env and fill in. .env is gitignored — never commit it, never paste
# its contents into a chat or an issue.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Public URLs ----------------------------------------------------------
# REQUIRED in production. Twilio signs webhooks against this exact URL; behind
# a TLS-terminating proxy the request Express sees is plain http, so signature
# checks fail without it.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:3000

# The origin printed into every QR code and written to every NFC tag, as
# {PUBLIC_FRONTEND_URL}/q/{token}. Falls back to PUBLIC_APP_URL. Production
# refuses to start without one of them: a stand printed against the wrong
# origin is already sitting on a customer's table and cannot be recalled.
PUBLIC_FRONTEND_URL=http://localhost:3000

# Comma-separated. Must be HTTPS in production. Localhost is added
# automatically outside production and never inside it.
CORS_ORIGINS=http://localhost:3000

# ---- Data stores ----------------------------------------------------------
DATABASE_URL=postgres://reviewboost:reviewboost@localhost:5432/reviewboost
DATABASE_POOL_MAX=10
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:6379

# ---- Secrets --------------------------------------------------------------
# Minimum 32 characters.   openssl rand -base64 48
JWT_SECRET=

# Base64-encoded 32 bytes.  openssl rand -base64 32
#
# Encrypts phone numbers, names, and feedback at rest, and keys the HMAC lookup
# columns. NOT ROTATABLE without re-encrypting every existing row — losing it
# makes all stored PII permanently unreadable. Keep it in a managed secret
# store and include it in backup procedures.
PII_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Set only when the API and app share a parent domain.
COOKIE_DOMAIN=
REQUIRE_EMAIL_VERIFICATION=false
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15
REGISTRATIONS_PER_HOUR_PER_IP=5

# ---- Twilio ---------------------------------------------------------------
# Keep dry-run on until you have deliberately tested one real send.
SMS_DRY_RUN=true

# Always required. Twilio Console home page. Starts with "AC".
TWILIO_ACCOUNT_SID=

# The number you send from, E.164 format.
TWILIO_FROM_NUMBER=

# Preferred way to authenticate SENDING. Console -> Account -> API keys.
# Scoped and independently revocable, so a leak does not compromise the
# whole account the way the Auth Token does.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# STILL REQUIRED even when using an API key above. Twilio signs inbound
# webhooks with the account Auth Token; an API key secret cannot verify them.
# Without this, delivery receipts and STOP replies are rejected and opt-outs
# stop working — which is a legal problem, not a bug.
TWILIO_AUTH_TOKEN=

# ---- Stripe ---------------------------------------------------------------
# All three required in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
TRIAL_DAYS=14

# ---- Email (Resend) -------------------------------------------------------
# Required in production: password reset and email verification depend on it.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM=ReviewBoost <noreply@yourdomain.com>
EMAIL_REPLY_TO=

# ---- Messaging policy -----------------------------------------------------
# Integer cents per SMS segment. Money is never a float anywhere.
SMS_PRICE_PER_SEGMENT_CENTS=2
DUPLICATE_WINDOW_DAYS=30
MAX_RECIPIENTS_PER_CAMPAIGN=5000

# TCPA quiet hours, in each recipient's local timezone. 8..21 permits sends
# from 08:00 up to but not including 21:00.
QUIET_HOURS_START=8
QUIET_HOURS_END=21

# ---- Workers --------------------------------------------------------------
SMS_WORKER_CONCURRENCY=10
# Keep at or below your Twilio per-number throughput, or carriers filter you.
SMS_PER_SECOND_LIMIT=10
REQUEST_TIMEOUT_MS=30000
