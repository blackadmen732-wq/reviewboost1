# ReviewBoost — Vercel Preview environment
#
# Preview is a public URL with a separate Supabase project. Copy these names
# into the Vercel project's Preview-scoped Environment Variables. Never reuse
# production credentials. Never commit real values.
#
# Required so proxy authentication can verify sessions. Missing URL/key is
# fail-closed (owner routes denied), not an auth skip.

# ---------------------------------------------------------------- Supabase --
# Preview project only. Distinct from production and from local Docker.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Secrets ---
# Preview-only keys. openssl rand -base64 32

CUSTOMER_NOTE_ENCRYPTION_KEY=
TOKEN_DIGEST_KEY=
TOKEN_DIGEST_KEY_VERSION=1

# --------------------------------------------------------------- URLs -------
# Preview origin. Must be HTTPS. Do not print stands against this URL.

PUBLIC_FRONTEND_URL=

# ------------------------------------------------------- Text Requests ------
# Fake provider only on Preview. No live Twilio.

SMS_PROVIDER=fake
SMS_WORKER_SECRET=
CRON_SECRET=
SMS_FAKE_WEBHOOK_SECRET=
SMS_PUBLIC_WEBHOOK_BASE_URL=
