# ReviewBoost — environment
#
# Copy to `.env.local` for development. That file is gitignored; this one is
# committed and must never contain a real value.
#
# For local development every value below comes from `supabase status -o json`
# after `supabase start`, except the two keys you generate yourself.

# ---------------------------------------------------------------- Supabase --

# Safe in the browser. It grants nothing on its own: every table denies `anon`,
# and Row Level Security decides what a signed-in session may see.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The same values, server-side. Kept separate so a change to one is a
# deliberate change, not an accident of shared naming.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# BYPASSES ROW LEVEL SECURITY. Server-only.
#
# Never rename this with a NEXT_PUBLIC_ prefix — that prefix is what decides
# whether Next inlines a value into the browser bundle, so the naming *is* the
# security boundary. The app refuses to start if it finds one, and CI fails the
# build.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Secrets ---

# Encrypts customer notes, praise, and the reprintable copy of stand tokens.
#   openssl rand -base64 32
#
# Belongs in a managed secret store and in the backup procedure. A database
# restored without it contains unreadable notes.
CUSTOMER_NOTE_ENCRYPTION_KEY=

# Produces the stand, session, and response token digests.
#   openssl rand -base64 32
#
# Separate from the encryption key on purpose: content can be re-encrypted, a
# digest cannot be recomputed without the original token. Sharing one key would
# mean that rotating it invalidated every printed QR code in the field.
# Falls back to CUSTOMER_NOTE_ENCRYPTION_KEY if unset.
TOKEN_DIGEST_KEY=
TOKEN_DIGEST_KEY_VERSION=1

# Set only while rotating TOKEN_DIGEST_KEY. Stands migrate themselves as they
# are scanned; remove this once none are left on the old version. Runbook:
# docs/backend/ENVIRONMENT.md
# TOKEN_DIGEST_KEY_PREVIOUS=

# ------------------------------------------------------------------- URLs ---

# The origin printed into every QR code and written to every NFC tag, as
# {PUBLIC_FRONTEND_URL}/q/{token}. Production refuses to start without it: a
# stand printed against the wrong origin is already on a customer's table and
# cannot be recalled.
PUBLIC_FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------ Development ---

# Customer-flow fixtures. Ignored when NODE_ENV is production.
NEXT_PUBLIC_USE_CUSTOMER_FIXTURES=false

# Leave blank for same-origin requests, which is the normal case now that the
# API and the app are one Next application.
NEXT_PUBLIC_API_BASE_URL=
