# ReviewBoost — environment
#
# Copy to `.env.local` for development. That file is gitignored; this one is
# committed and must never contain a real value.
#
# For local development every value below comes from `supabase status -o json`
# after `supabase start`, except the two keys you generate yourself.

# ---------------------------------------------------------------- Supabase --

# Safe in the browser. It grants nothing on its own: every table denies `anon`,
# and Row Level Security decides what a signed-in session may see.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The same values, server-side. Kept separate so a change to one is a
# deliberate change, not an accident of shared naming.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# BYPASSES ROW LEVEL SECURITY. Server-only.
#
# Never rename this with a NEXT_PUBLIC_ prefix — that prefix is what decides
# whether Next inlines a value into the browser bundle, so the naming *is* the
# security boundary. The app refuses to start if it finds one, and CI fails the
# build.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Secrets ---

# Encrypts customer notes, praise, and the reprintable copy of stand tokens.
#   openssl rand -base64 32
#
# MUST be its own independent, freshly generated base64 32-byte value. Never
# reuse a secret from another service here — a live payment key was once pasted
# into this variable, which both broke decryption and exposed that key.
#
# Belongs in a managed secret store and in the backup procedure. A database
# restored without it contains unreadable notes.
CUSTOMER_NOTE_ENCRYPTION_KEY=

# Produces the stand, session, and response token digests.
#   openssl rand -base64 32
#
# Separate from the encryption key on purpose: content can be re-encrypted, a
# digest cannot be recomputed without the original token. Sharing one key would
# mean that rotating it invalidated every printed QR code in the field.
# Falls back to CUSTOMER_NOTE_ENCRYPTION_KEY if unset — that fallback is for
# local dev only. Production MUST set an independent value here before any real
# stand is printed, so the two keys can rotate on their own terms.
TOKEN_DIGEST_KEY=
TOKEN_DIGEST_KEY_VERSION=1

# Set only while rotating TOKEN_DIGEST_KEY. Stands migrate themselves as they
# are scanned; remove this once none are left on the old version. Runbook:
# docs/backend/ENVIRONMENT.md
# TOKEN_DIGEST_KEY_PREVIOUS=

# ------------------------------------------------------------------- URLs ---

# The origin printed into every QR code and written to every NFC tag, as
# {PUBLIC_FRONTEND_URL}/q/{token}. Production refuses to start without it: a
# stand printed against the wrong origin is already on a customer's table and
# cannot be recalled. In production this MUST be https://reviewboost.fit — never
# a localhost or a *.vercel.app preview URL.
PUBLIC_FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------ Development ---

# Customer-flow fixtures. Ignored when NODE_ENV is production.
NEXT_PUBLIC_USE_CUSTOMER_FIXTURES=false

# Leave blank for same-origin requests, which is the normal case now that the
# API and the app are one Next application.
NEXT_PUBLIC_API_BASE_URL=

# --- Text Requests / SMS (backend foundation) ---------------------------
# All optional until Text Requests are turned on. Absent a provider, the fake
# provider is used in development and every real send is a no-op.
#
# Provider selection: "twilio" or "fake". In production a selected provider
# that is unconfigured is a hard error, never a silent no-op.
SMS_PROVIDER=fake
# Twilio credentials — server-only secrets, never committed, never NEXT_PUBLIC_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of a From number or a Messaging Service SID (MG...).
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Per-segment price in integer micro-units (1e-6 of the currency). No default
# in production — set it to your real provider rate. Example: 7500 = $0.0075.
SMS_RATE_PER_SEGMENT_MICROS=
SMS_RATE_CURRENCY=USD
# Default country calling code for national numbers (digits only, e.g. 1).
SMS_DEFAULT_COUNTRY_CALLING_CODE=
# Shared secret the dispatch scheduler presents to POST /api/v1/internal/sms/dispatch.
SMS_WORKER_SECRET=
# Public base URL that providers post webhooks to (no trailing slash), e.g.
# https://app.example.com. Used to build the Twilio StatusCallback so a send can
# progress to delivered/failed. No default — delivery callbacks are omitted when
# unset rather than pointing at a guessed URL.
SMS_PUBLIC_WEBHOOK_BASE_URL=
# When SMS_PROVIDER=fake is used in PRODUCTION, inbound webhooks must present this
# shared secret in the x-fake-signature header; without it every fake webhook is
# rejected. Leave unset outside production (the fake trusts its own test events).
SMS_FAKE_WEBHOOK_SECRET=
