{
  "expo": {
    "name": "ReviewBoost",
    "slug": "reviewboost",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "reviewboost",
    "ios": {
      "bundleIdentifier": "fit.reviewboost.app",
      "supportsTablet": true,
      "infoPlist": {
        "NFCReaderUsageDescription": "ReviewBoost uses NFC to program your Tags."
      }
    },
    "android": {
      "package": "fit.reviewboost.app",
      "adaptiveIcon": {
        "backgroundColor": "#035B3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store", "react-native-nfc-manager"]
  }
}
