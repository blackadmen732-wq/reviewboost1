# ReviewBoost mobile — environment
#
# Copy to `.env` for development. That file is gitignored.
#
# These are the publishable (anon) credentials only. They grant nothing
# on their own — every table denies `anon`, and what a signed-in session
# may see is decided by Row Level Security in the database.
#
# Never put the service-role key here or anywhere in the mobile app.
#
# Production values are injected by EAS at build time (see eas.json). The
# anon key is provided as an EAS secret rather than committed here:
#   eas secret:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value <anon key>

# Production Supabase project is zoyqikgqfqulwkihjbev.
EXPO_PUBLIC_SUPABASE_URL=https://zoyqikgqfqulwkihjbev.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The web app origin the mobile client calls. Production is the live domain.
EXPO_PUBLIC_API_URL=https://reviewboost.fit
