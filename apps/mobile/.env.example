# ReviewBoost mobile — environment
#
# Copy to `.env` for development. That file is gitignored.
#
# These are the publishable (anon) credentials only. They grant nothing
# on their own — every table denies `anon`, and what a signed-in session
# may see is decided by Row Level Security in the database.
#
# Never put the service-role key here or anywhere in the mobile app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
