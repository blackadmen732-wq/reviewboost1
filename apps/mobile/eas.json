{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://zoyqikgqfqulwkihjbev.supabase.co",
        "EXPO_PUBLIC_API_URL": "https://reviewboost.fit"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://zoyqikgqfqulwkihjbev.supabase.co",
        "EXPO_PUBLIC_API_URL": "https://reviewboost.fit"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://zoyqikgqfqulwkihjbev.supabase.co",
        "EXPO_PUBLIC_API_URL": "https://reviewboost.fit"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "production"
      },
      "ios": {
        "ascApiKeyPath": "./credentials/asc-api-key.p8"
      }
    }
  }
}
